{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tollbooth-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDO"
      }
    ]
  },
  "exports": {
    "SessionDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tollbooth-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/d1"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/paypal/*", "/webhooks/*", "/health"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8787",
    "ENVIRONMENT": "local",
    "MERCHANT_ID": "tollbooth.demo"
  }
}
