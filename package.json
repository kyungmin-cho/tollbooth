{
  "name": "tollbooth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:workers": "vitest run tests/workers",
    "test:contract": "vitest run tests/contract",
    "typecheck": "pnpm types && tsc --noEmit",
    "lint": "biome check .",
    "build": "vite build && pnpm types",
    "db:local": "wrangler d1 migrations apply tollbooth-local --local",
    "sandbox": "node scripts/e2e-sandbox/index.mjs",
    "sandbox:setup": "node scripts/e2e-sandbox/setup-local.mjs",
    "verify:secrets": "node scripts/verify/scan-secrets.mjs",
    "types": "wrangler types --include-env false",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "agents": "0.28.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1",
    "ws": "8.21.0"
  }
}
