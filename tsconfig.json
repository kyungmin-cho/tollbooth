{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/vitest-plugin/types", "node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/web/*"] }
  },
  "include": ["src", "tests", "scripts", "*.ts", "worker-configuration.d.ts"]
}
